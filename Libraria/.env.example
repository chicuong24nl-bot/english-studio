# .env.local

# disabled telemetry
DO_NOT_TRACK="1"
NEXT_TELEMETRY_DISABLED="1"
CLERK_TELEMETRY_DISABLED="1"

# Teacher Supabase Auth (teacher users must also be listed in libraria_teacher_accounts).
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Generate with `openssl rand -hex 32`; server-only session signing key.
LIBRARIA_TEACHER_SESSION_SECRET=replace_with_a_random_64_character_hex_secret

# Shared /demo classroom storage (keep SUPABASE_SECRET_KEY server-side only).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# clerk auth keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=replace_me

# clerk redirect urls
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# neon db uri
DATABASE_URL="postgresql://<user>:<password>@<host>:<post>/lingo?sslmode=require"

# stripe api key and webhook
STRIPE_API_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me

# public app url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# clerk admin user id(s) separated by comma (,)
CLERK_ADMIN_IDS="user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# or CLERK_ADMIN_IDS="user_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx, user_xxxxxxxxxxxxxxxxxxxxxx" for multiple admins.
